# Leave empty to call the API on the same origin (/api):
#   - Docker: nginx proxies /api -> api:8080
#   - Vercel: vercel.json rewrites /api -> http://<oracle-ip>:8080 (no CORS / mixed content)
#   - Dev: Vite dev proxy
# Set to a full URL only if the API lives on another origin (requires CORS on the API).
VITE_API_BASE_URL=
# Dev only: where the Vite dev server proxies /api to
VITE_PROXY_TARGET=http://localhost:8080
