ConnectionStrings__DefaultConnection=Server=gateway01.ap-southeast-1.prod.aws.tidbcloud.com;Port=4000;Database=cranberry_api;User ID=<user>;Password=<password>;SslMode=VerifyFull

JWT__ValidIssuer=http://<oracle-public-ip>:8080
JWT__ValidAudience=http://<oracle-public-ip>:8080
JWT__Secret=<chuoi-ngau-nhien-it-nhat-32-ky-tu>
# Tuỳ chọn: số ngày một lần đăng nhập còn hiệu lực, mặc định 30
# JWT__ExpiryDays=30

# Gmail SMTP (App Password: https://myaccount.google.com/apppasswords)
Email__Host=smtp.gmail.com
Email__Port=587
Email__Username=<your-gmail>@gmail.com
Email__Password=<16-ky-tu-app-password-khong-dau-cach>
Email__SenderName=Unplug

# Whisper local (voice-to-diary). Tuỳ chọn, mặc định là service `transcriber` trong docker-compose.yml
# Whisper__Url=http://transcriber:8000
